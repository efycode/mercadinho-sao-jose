# Configuração para rodar o sistema no SEU COMPUTADOR (desenvolvimento).
# Copie este arquivo para .env (ele não vai para o GitHub) e preencha os valores.
#
# No Render você NÃO usa este arquivo: as mesmas variáveis são cadastradas no painel
# do serviço, em Environment (veja "Como publicar" no README).

# Banco PostgreSQL. Local, como abaixo, ou o endereço do Neon, que tem o formato
# postgresql://USUARIO:SENHA@ep-...-pooler.REGIAO.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=postgresql://mercadinho:mercadinho@localhost:5432/mercadinho

# Porta do servidor Web (o Render define a dele sozinho).
PORT=3000

# Em produção, use NODE_ENV=production.
NODE_ENV=development

# Fuso usado para "hoje" nas previsões.
FUSO_HORARIO=America/Fortaleza

# true = cria os dados de demonstração na primeira vez que o servidor sobe com o banco vazio.
POPULAR_DEMO_SE_VAZIO=true

NOME_DO_NEGOCIO=Mercadinho São José

# Acesso ao sistema (tela de login), ajustado sempre que o servidor sobe: trocar a senha encerra
# as sessões abertas, e trocar o usuário remove o anterior. Sem estas variáveis, vale avaliacao / mercadinho2026.
LOGIN_USUARIO=avaliacao
LOGIN_SENHA=mercadinho2026
LOGIN_NOME=Equipe de avaliação
# true = mostra o usuário e a senha na tela de login (útil na avaliação do trabalho).
MOSTRAR_ACESSO_NA_TELA_DE_LOGIN=true

# Envio dos pedidos de cotação: simulacao | brevo | smtp (veja o README).
EMAIL_MODO=simulacao
EMAIL_REMETENTE_NOME="Mercadinho São José"
EMAIL_REMETENTE_ENDERECO=seu-email-verificado@exemplo.com
EMAIL_RESPONDER_PARA=seu-email@exemplo.com
EMAIL_LIMITE_DIARIO=20

# Só para EMAIL_MODO=brevo (o modo que funciona no Render gratuito)
BREVO_API_KEY=

# Só para EMAIL_MODO=smtp (no seu computador; o Render gratuito bloqueia as portas SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_USUARIO=seu-email@gmail.com
SMTP_SENHA=senha-de-app-de-16-letras
